# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings > API. Both values are safe to expose to the browser:
# every write is protected by Row Level Security and the admin allowlist.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. Email a copy of each inquiry to the owner, using resend.com.
# Both are needed. INQUIRY_FROM_EMAIL is optional: leave it out to use Resend's
# test sender, which only delivers to the address your Resend account uses.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
INQUIRY_FROM_EMAIL=

# Optional. Also send each inquiry as JSON to this URL (for an automation tool).
CONTACT_WEBHOOK_URL=
